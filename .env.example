# Copy to .env and fill in the keys you have. .env is gitignored — never commit it.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Default model so you don't need --model every time (provider/model-id)
JARVIS_MODEL=groq/openai/gpt-oss-120b
# Fallback models, tried in order when the main one is rate-limited or down (comma-separated)
JARVIS_FALLBACKS=groq/qwen/qwen3.8-27b
